import dotenv from 'dotenv';
import { SecretManagerServiceClient } from '@google-cloud/secret-manager';

dotenv.config();

export interface SecretCheckResult {
  key: string;
  status: 'PRESENT' | 'MISSING';
}

const client = new SecretManagerServiceClient();

function getProjectId(): string {
  return (
    process.env.GOOGLE_CLOUD_PROJECT ||
    process.env.GCLOUD_PROJECT ||
    'krypton-ai-490214'
  );
}

/**
 * FIKO CONNECT — SECRET MANAGER
 *
 * Priorité :
 * 1. process.env
 * 2. Google Secret Manager
 *
 * Les secrets ne sont jamais affichés dans les logs.
 */
export async function getSecret(
  secretName: string
): Promise<string | null> {
  // 1. Environment variable
  const envValue = process.env[secretName];

  if (envValue && envValue.trim()) {
    return envValue.trim();
  }

  // 2. Google Secret Manager
  try {
    const projectId = getProjectId();

    const [version] = await client.accessSecretVersion({
      name: `projects/${projectId}/secrets/${secretName}/versions/latest`,
    });

    const value = version.payload?.data?.toString();

    if (value && value.trim()) {
      const secret = value.trim();

      // Make the secret available to the existing provider layer.
      process.env[secretName] = secret;

      return secret;
    }

    return null;
  } catch (error: any) {
    const code = error?.code;
    const message = error?.message || 'SECRET_MANAGER_ERROR';

    console.error(
      `[SECRET MANAGER] ${secretName} unavailable code=${code ?? 'unknown'} reason=${message}`
    );

    return null;
  }
}

export async function checkSecrets(
  keys: string[]
): Promise<SecretCheckResult[]> {
  const results: SecretCheckResult[] = [];

  for (const key of keys) {
    const val = await getSecret(key);

    results.push({
      key,
      status: val ? 'PRESENT' : 'MISSING',
    });
  }

  return results;
}
