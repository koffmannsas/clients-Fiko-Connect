{
  "entities": {
    "User": {
      "title": "User",
      "description": "Represents an authenticated entrepreneur or team member using Fiko OS.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "Unique identifier for Firebase user" },
        "displayName": { "type": "string", "description": "The user's full name" },
        "email": { "type": "string", "description": "User email address" },
        "phoneNumber": { "type": "string", "description": "WhatsApp or contact number" },
        "companyId": { "type": "string", "description": "ID of associated company" },
        "role": { "type": "string", "description": "Role of user (owner or member)" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "displayName", "email", "createdAt"]
    },
    "Company": {
      "title": "Company",
      "description": "Represents the business enterprise profile.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique company document ID" },
        "name": { "type": "string", "description": "Company name" },
        "industry": { "type": "string", "description": "Industry or target domain category" },
        "country": { "type": "string", "description": "Operational country" },
        "whatsappNumber": { "type": "string", "description": "Liaison WhatsApp number" },
        "ownerId": { "type": "string", "description": "User UID who owns this enterprise" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "name", "industry", "country", "ownerId", "createdAt"]
    },
    "Subscription": {
      "title": "Subscription",
      "description": "Enterprise billing, usage quota and selected plans.",
      "type": "object",
      "properties": {
        "companyId": { "type": "string", "description": "ID of associated company" },
        "plan": { "type": "string", "enum": ["free", "starter", "business", "scale", "elite"] },
        "status": { "type": "string", "enum": ["active", "suspended", "expired"] },
        "maxContacts": { "type": "integer" },
        "messagesSent": { "type": "integer" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["companyId", "plan", "status", "createdAt"]
    },
    "FikoMemory": {
      "title": "FikoMemory",
      "description": "AI knowledge graph, conversation intelligence metrics and business logs.",
      "type": "object",
      "properties": {
        "companyId": { "type": "string", "description": "Reference company ID" },
        "messagesProcessedCount": { "type": "integer" },
        "cognitiveTokensCount": { "type": "integer" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["companyId", "messagesProcessedCount", "updatedAt"]
    },
    "Agent": {
      "title": "Agent",
      "description": "Individual deployed AI copilot instances configured for WhatsApp or live chat.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "companyId": { "type": "string" },
        "name": { "type": "string" },
        "status": { "type": "string" },
        "autoPilot": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "companyId", "name", "status", "autoPilot", "createdAt"]
    },
    "KnowledgeProfile": {
      "title": "KnowledgeProfile",
      "description": "Company Business Identity Engine and Sales Authority Engine configuration.",
      "type": "object",
      "properties": {
        "companyId": { "type": "string" },
        "identity": { "type": "object" },
        "policy": { "type": "object" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["companyId", "identity", "policy", "updatedAt"]
    },
    "KnowledgeItem": {
      "title": "KnowledgeItem",
      "description": "Verified or pending business knowledge unit with source traceability.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "companyId": { "type": "string" },
        "title": { "type": "string", "maxLength": 180 },
        "category": { "type": "string" },
        "content": { "type": "string", "maxLength": 4000 },
        "status": { "type": "string", "enum": ["validated", "pending_verification", "rejected", "conflict"] },
        "source": { "type": "string" },
        "validUntil": { "type": "string" },
        "responsible": { "type": "string" },
        "scope": { "type": "string" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "companyId", "title", "category", "content", "status", "source"]
    },
    "TrainingRule": {
      "title": "TrainingRule",
      "description": "Fiko Training Academy rule or conversation scenario.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "companyId": { "type": "string" },
        "title": { "type": "string" },
        "scenarioType": { "type": "string" },
        "customerTrigger": { "type": "string" },
        "expectedBehavior": { "type": "string" },
        "testedBeforeActivation": { "type": "boolean" },
        "isActive": { "type": "boolean" }
      },
      "required": ["id", "companyId", "title", "customerTrigger", "expectedBehavior"]
    },
    "HumanApproval": {
      "title": "HumanApproval",
      "description": "Human Approval Engine escalation queue item.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "companyId": { "type": "string" },
        "customerName": { "type": "string" },
        "customerMessage": { "type": "string" },
        "requestedAction": { "type": "string" },
        "truthLevel": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "approved", "rejected", "resolved"] }
      },
      "required": ["id", "companyId", "customerMessage", "truthLevel", "status"]
    },
    "LearningSuggestion": {
      "title": "LearningSuggestion",
      "description": "Continuous Learning Engine unanswered query and improvement suggestion.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "companyId": { "type": "string" },
        "unansweredQuestion": { "type": "string" },
        "status": { "type": "string", "enum": ["suggested", "converted_to_pending", "dismissed"] }
      },
      "required": ["id", "companyId", "unansweredQuestion", "status"]
    },
    "ScanJob": {
      "title": "ScanJob",
      "description": "Fiko Deep Scan job record storing crawled pages and extraction counts per company.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "companyId": { "type": "string" },
        "sourceType": { "type": "string", "enum": ["website", "document"] },
        "sourceLabel": { "type": "string" },
        "status": { "type": "string", "enum": ["completed", "failed"] },
        "extractedCount": { "type": "integer" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "companyId", "sourceType", "sourceLabel", "status", "createdAt"]
    },
    "LearningSession": {
      "title": "LearningSession",
      "description": "Persistent Fiko Learning Live conversational training history per company.",
      "type": "object",
      "properties": {
        "companyId": { "type": "string" },
        "currentStep": { "type": "integer" },
        "messages": { "type": "array" },
        "pendingClarifications": { "type": "array" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["companyId", "currentStep", "messages", "updatedAt"]
    },
    "KnowledgeVersion": {
      "title": "KnowledgeVersion",
      "description": "Versioned snapshot of approved knowledge base enabling instant rollback.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "companyId": { "type": "string" },
        "versionNumber": { "type": "integer" },
        "label": { "type": "string" },
        "approvedCount": { "type": "integer" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "companyId", "versionNumber", "label", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User accounts with roles"
    },
    "/companies/{companyId}": {
      "schema": "Company",
      "description": "Business organizations"
    },
    "/subscriptions/{subscriptionId}": {
      "schema": "Subscription",
      "description": "Entitlement settings"
    },
    "/fiko_memory/{memoryId}": {
      "schema": "FikoMemory",
      "description": "Cognitive long-term memories"
    },
    "/agents/{agentId}": {
      "schema": "Agent",
      "description": "Configured assistant agents"
    },
    "/fiko_knowledge_profiles/{companyId}": {
      "schema": "KnowledgeProfile",
      "description": "Business Identity and Sales Authority policy per company"
    },
    "/knowledge_items/{itemId}": {
      "schema": "KnowledgeItem",
      "description": "Company knowledge base items with truth status and source traceability"
    },
    "/knowledge_training/{ruleId}": {
      "schema": "TrainingRule",
      "description": "Training Academy instructions and sales scenarios"
    },
    "/knowledge_approvals/{approvalId}": {
      "schema": "HumanApproval",
      "description": "Human Approval Engine escalation queue"
    },
    "/knowledge_learning/{suggestionId}": {
      "schema": "LearningSuggestion",
      "description": "Continuous Learning unanswered questions awaiting human validation"
    },
    "/knowledge_scan_jobs/{jobId}": {
      "schema": "ScanJob",
      "description": "Fiko Deep Scan history and crawled source records"
    },
    "/knowledge_learning_sessions/{companyId}": {
      "schema": "LearningSession",
      "description": "Fiko Learning Live persistent conversational training sessions"
    },
    "/knowledge_versions/{versionId}": {
      "schema": "KnowledgeVersion",
      "description": "Versioned snapshots of approved company knowledge bases"
    }
  }
}
