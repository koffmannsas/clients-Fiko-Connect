rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(companyId) {
      return request.auth != null && request.auth.uid == companyId;
    }
    match /companies/{companyId} { allow read, write: if isOwner(companyId); }
    match /leads/{leadId} { allow read, write: if request.auth != null && (resource == null || resource.data.companyId == request.auth.uid); }
    match /messages/{messageId} { allow read, write: if request.auth != null && (resource == null || resource.data.companyId == request.auth.uid); }
    match /fiko_memory/{companyId} { allow read, write: if isOwner(companyId); }
    match /dna_products/{id} { allow read, write: if request.auth != null && resource.data.companyId == request.auth.uid; }
    match /dna_pricing/{id} { allow read, write: if request.auth != null && resource.data.companyId == request.auth.uid; }
    match /dna_objections/{id} { allow read, write: if request.auth != null && resource.data.companyId == request.auth.uid; }
    match /dna_faq/{id} { allow read, write: if request.auth != null && resource.data.companyId == request.auth.uid; }
    match /vault/{id} { allow read, write: if false; }
    match /otp_sessions/{id} { allow read, write: if false; }
  }
}
