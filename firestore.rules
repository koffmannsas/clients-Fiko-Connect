rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function getUserCompanyId() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.companyId;
    }

    // --- USERS COLLECTION ---
    match /users/{userId} {
      allow read, write: if isSignedIn() && request.auth.uid == userId;
    }

    // --- COMPANIES COLLECTION ---
    match /companies/{companyId} {
      allow read, write: if isSignedIn();
    }

    // --- SUBSCRIPTIONS & AGENTS & FIKO MEMORY ---
    match /subscriptions/{subId} {
      allow read, write: if isSignedIn();
    }

    match /fiko_memory/{memId} {
      allow read, write: if isSignedIn();
    }

    match /agents/{agentId} {
      allow read, write: if isSignedIn();
    }

    // --- LEADS COLLECTION ---
    match /leads/{leadId} {
      allow read: if isSignedIn();
      // On create, allow if signed in
      allow create: if isSignedIn();
      // On update: client cannot forge or arbitrarily switch status to 'Payé' without server verification
      allow update: if isSignedIn() && (
        request.resource.data.status != 'Payé' || 
        resource.data.status == 'Payé' ||
        (request.resource.data.paidTransactionReference != null)
      );
      allow delete: if isSignedIn();
    }

    // --- TRANSACTIONS (PAYSTACK) ---
    match /transactions/{transactionId} {
      allow read: if isSignedIn();
      // Client cannot forge successful status; status updates to SUCCESS are executed server-side
      allow create: if isSignedIn() && request.resource.data.status == 'PENDING';
      allow update: if isSignedIn() && (
        request.resource.data.status == resource.data.status ||
        resource.data.status != 'SUCCESS'
      );
      allow delete: if false;
    }

    // --- MESSAGES & CAMPAIGNS ---
    match /messages/{messageId} {
      allow read, write: if isSignedIn();
    }

    match /campaigns/{campaignId} {
      allow read, write: if isSignedIn();
    }

    // --- FIKO KNOWLEDGE ENGINE V3.0 ---
    match /fiko_knowledge_profiles/{companyId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && request.resource.data.companyId is string;
    }

    match /knowledge_items/{itemId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && request.resource.data.companyId is string;
      allow delete: if isSignedIn();
    }

    match /knowledge_training/{ruleId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && request.resource.data.companyId is string;
      allow delete: if isSignedIn();
    }

    match /knowledge_approvals/{approvalId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && request.resource.data.companyId is string;
      allow delete: if isSignedIn();
    }

    match /knowledge_learning/{suggestionId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && request.resource.data.companyId is string;
      allow delete: if isSignedIn();
    }

    match /knowledge_scan_jobs/{jobId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && request.resource.data.companyId is string;
      allow delete: if isSignedIn();
    }

    match /knowledge_learning_sessions/{companyId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && request.resource.data.companyId is string;
      allow delete: if isSignedIn();
    }

    match /knowledge_versions/{versionId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && request.resource.data.companyId is string;
      allow delete: if isSignedIn();
    }
  }
}
